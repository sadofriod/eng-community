# Database
# Replace with your actual PostgreSQL connection string
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/engcoach?schema=public"

# DeepSeek API Key (for LLM feedback generation)
DEEPSEEK_API_KEY="your-deepseek-api-key"

# Transcription API Key — used for Whisper speech-to-text
# Set TRANSCRIPTION_API_KEY first; falls back to OPENAI_API_KEY if not set
TRANSCRIPTION_API_KEY="your-openai-api-key"
# OPENAI_API_KEY="your-openai-api-key"

# Optional: Custom base URL for transcription (default: https://api.openai.com/v1)
# TRANSCRIPTION_BASE_URL="https://api.openai.com/v1"
